<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<IsPackable>true</IsPackable>

		<!-- Pulse is a library, not a stand-alone testhost. Suppress MTP's auto-detection so
		     C# Dev Kit / Test Explorer don't schedule discovery on this DLL. -->
		<IsTestProject>false</IsTestProject>
		<IsTestingPlatformApplication>false</IsTestingPlatformApplication>

		<!-- Trim safety: the registration chain carries DynamicallyAccessedMembers annotations.
		     Trim diagnostics are errors so a future unannotated reflection site fails the build
		     instead of silently dropping registered suite members in trimmed hosts. -->
		<IsTrimmable>true</IsTrimmable>
		<EnableTrimAnalyzer>true</EnableTrimAnalyzer>
		<WarningsAsErrors>IL2026;IL2067;IL2070;IL2072;IL2075;IL2087;IL3050</WarningsAsErrors>

		<PackageId>Circuids.Pulse</PackageId>
		<Version>1.0.0-preview3</Version>
		<Authors>Circuids</Authors>
		<Company>Circuids</Company>
		<PackageIcon>icon.png</PackageIcon>
		<Description>Pulse runs your tests inside the real app so you can verify behavior where it actually matters. A slim, embeddable .NET test runner for real host apps, real DI graphs, and real platform services.</Description>
		<PackageTags>testing;runtime-tests;conformance;blazor;maui;mtp;microsoft-testing-platform</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageProjectUrl>https://github.com/Circuids/Pulse</PackageProjectUrl>
		<RepositoryUrl>https://github.com/Circuids/Pulse</RepositoryUrl>
		<Copyright>© Circuids. All rights reserved.</Copyright>
		<PackageReleaseNotes>$([System.IO.File]::ReadAllText("$(MSBuildProjectDirectory)/ReleaseNotes.txt"))</PackageReleaseNotes>
		<RepositoryType>git</RepositoryType>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<DebugType>portable</DebugType>
		<Copyright>© Circuids. All rights reserved.</Copyright>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.15" />
		<!-- Keep MTP's MSBuild targets local — stops them propagating to consumer projects
		     (Blazor / MAUI samples) and marking those as testhosts. Runtime DLL still flows. -->
		<PackageReference Include="Microsoft.Testing.Platform" Version="2.5.3"
		                  PrivateAssets="build;buildMultitargeting;buildTransitive;analyzers" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\README.md" Pack="true" PackagePath="\" Condition="Exists('..\..\README.md')" />
		<None Include="..\..\images\icon.png" PackagePath="icon.png" Pack="true" />
	</ItemGroup>

</Project>
