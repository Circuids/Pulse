<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
		<!-- MTP-v2 variant of the same xunit.v3 3.2.2 API — lockstep with Circuids.Pulse's
		     Microsoft.Testing.Platform 2.x pin (architecture §4.1). -->
		<PackageReference Include="xunit.v3.mtp-v2" Version="3.2.2" />
		<PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.15" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\Circuids.Pulse\Circuids.Pulse.csproj" />
	</ItemGroup>

</Project>
